@DevicesApi_HostAddress = http://localhost:5251

@DeviceId = 86a83b5f-bab0-40ed-bec4-933943638e62
@name = iPhone 17 Pro Max
@brand = Apple
@state = Available

@stateAvaiable = Available
@stateInUse = InUse
@stateInactive = Inactive

@DeviceIdToUpdate = a1cb0311-dc3f-4fca-855b-9b6c35f00921
@DeviceIdToDelete = 45f8ad04-a149-4097-8ccb-09d2d8bde5cd

### Create a new device
POST {{DevicesApi_HostAddress}}/devices
Content-Type: application/json
{
  "name": "Samsung S25",
  "brand": "Samsung"
}

### Delete a device
DELETE {{DevicesApi_HostAddress}}/devices/{{DeviceIdToDelete}}

### Fully Update a device
PUT {{DevicesApi_HostAddress}}/devices/{{DeviceIdToUpdate}}
Content-Type: application/json

{
  "NewName": "Samsung S25 Ultra 2",
  "NewBrand": "Samsung 2",
  "NewState": "{{state}}"
}

### Partially Update a device
PATCH {{DevicesApi_HostAddress}}/devices/{{DeviceIdToUpdate}}
Content-Type: application/json
{
  "newstate": "{{stateAvaiable}}"
}

### Get all devices
GET {{DevicesApi_HostAddress}}/devices
Accept: application/json

### Get device by ID
GET {{DevicesApi_HostAddress}}/devices/{{DeviceId}}
Accept: application/json

### Get All devices by brand
GET {{DevicesApi_HostAddress}}/devices/byBrand?brand={{brand}}
Accept: application/json

### Get All devices by State
GET {{DevicesApi_HostAddress}}/devices/byState?state={{stateAvaiable}}
Accept: application/json
